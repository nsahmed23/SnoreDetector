# Copy to .env and fill in. .env is gitignored.

# Required
DATABASE_URL=postgres://snoreguard:dev-only-password@localhost:5432/snoreguard?sslmode=disable
JWT_SIGNING_KEY=replace-me-with-a-real-32-byte-secret-please-1234567

# Optional (defaults shown)
ADDR=:8080
APPLE_AUDIENCE=com.snoreguard.app
APPLE_ISSUER=https://appleid.apple.com
JWT_ISSUER=snoreguard-sync
JWT_TTL=720h
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
